# .env.example

# Database connection string used by SQLAlchemy.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/seat_reservation

# Secret used to sign/verify the application's JWT tokens.
JWT_SECRET=change-me

# Python logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL).
LOG_LEVEL=DEBUG

# For local burst testing ONLY, make this the same as JWT_SECRET
BURST_JWT_SECRET=change-me
